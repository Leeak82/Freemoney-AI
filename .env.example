# FreeMoney-AI Configuration

# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Database (PostgreSQL / Supabase compatible)
DATABASE_URL=postgresql://freemoney:freemoney@localhost:5432/freemoney_ai
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Security & Admin
ADMIN_API_KEY=dev-admin-secret-key-change-in-production
ENABLE_ADMIN_API=true

# External APIs
GRANTS_GOV_API_URL=https://api.grants.gov/v1/api
TREASURY_API_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service

# AI Matching Provider (rule_based | openai | anthropic | mock)
AI_MATCHER_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL_NAME=

# Feature Flags
ENABLE_DISCOVERY_CRAWLER=true
SYNC_CRON_ENABLED=false
MAX_OPPORTUNITY_FETCH_ROWS=100
